# Esempio — copiare in /root/.ardy-backup.env sul VPS (NON versionato, NON in
# questo repo) e riempire con i valori veri. Letto da infra/backup-b2.sh.

# Nome del database applicativo (stesso di ARDY_DB_NAME in ardy-config.php)
ARDY_DB_NAME=ardyagent

# Utente MySQL a permessi ridotti dedicato al backup (non l'utente applicativo
# pieno) — vedi il commento in infra/setup-vps.sh, sezione MariaDB, per il
# GRANT minimo (SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER).
ARDY_DB_BACKUP_USER=ardy_backup
ARDY_DB_BACKUP_PASS=

# Nome del remoto configurato con `rclone config` (tipo: Backblaze B2)
RCLONE_REMOTE=b2-ardy

# Bucket e prefisso — riusare l'account B2 già aperto (PIANO-MIGRAZIONE.md §4
# Fase 0); un prefisso dedicato per questo VPS tiene i backup separati dagli
# altri bucket/server già in uso (UGLmico/srv1, micoper).
B2_BUCKET=
B2_PREFIX=ardyagent-vps

# Solo se la cartella privata non è nel percorso di default (/home/ardy/ardy-private)
# ARDY_PRIVATE_DIR=/home/ardy/ardy-private
