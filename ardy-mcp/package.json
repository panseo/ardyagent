{
  "name": "ardy-mcp-server",
  "version": "1.0.0",
  "description": "Server MCP per Ardy Lab: contatti outreach, generazione messaggi e invio sui canali ufficiali",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "ardy-mcp-server": "dist/index.js" },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
