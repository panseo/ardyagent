# Impedisce l'accesso diretto ai file di configurazione
<Files "ardy-config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Blocca accesso a file sensibili
<FilesMatch "\.(log|txt|json|md|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Blocca accesso diretto a file PHP interni (non API)
<FilesMatch "^(ardy-db|ardy-auth|ardy-net|ardy-web-memoria|ardy-email)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Blocca directory listing
Options -Indexes

# La root del dominio serve direttamente la dashboard (resta dietro Basic Auth
# via FilesMatch più sotto).
DirectoryIndex ardy-michela-app.html

# -----------------------------------------------------------
# GZIP — comprime le risposte testuali (HTML/CSS/JS/JSON) per ridurre il
# traffico e velocizzare il caricamento. NON tocca le immagini (jpeg/png/webp:
# già compresse). Dentro <IfModule>: se mod_deflate non c'è, viene ignorato.
# -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# -----------------------------------------------------------
# CACHE DEGLI ASSET STATICI
# - Immagini/font: cambiano di rado → cache lunga (30 giorni).
# - CSS/JS: in sviluppo attivo → cache breve + revalidation (ETag/Last-Modified
#   sono già emessi da Apache): dopo la scadenza il browser fa una richiesta
#   condizionale e riceve 304 se il file non è cambiato, il file nuovo se lo è.
#   Niente cache-busting manuale (`?v=`) → nessun rischio di servire CSS vecchio.
# -----------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon  "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff  "access plus 30 days"
    ExpiresByType text/css               "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript        "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
    # CSS/JS: pubblici ma da rivalidare alla scadenza (no stale silenzioso).
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    # Immagini/font: cache lunga.
    <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------
# LOGIN (Basic Auth) — protegge SOLO le pagine private.
# Le pagine pubbliche (chatbot, widget, unsubscribe) restano aperte.
# Il file con utente+password (.htpasswd) si crea con ardy-setup-login.php
# -----------------------------------------------------------
<FilesMatch "^(ardy-michela-app\.html|ardy-crm-api\.php|ardy-update-lead\.php|ardy-preventivo\.php|ardy-get-fasi\.php|ardy-pubblica-lavorazione\.php|ardy-pubblica-social\.php|ardy-crea-reel\.php|ardy-pubblica-reel\.php|ardy-lista-musica\.php|ardy-reel-template-api\.php|ardy-libreria-api\.php|ardy-lead-foto\.php|ardy-upload-video\.php|ardy-stats\.php|ardy-solleciti\.php|ardy-outreach\.html|ardy-outreach-api\.php|ardy-email-finder\.php|ardy-gcal\.php|ardy-gcal-auth\.php|ardy-import-preventivi\.php|ardy-import-scheda-pdf\.php|ardy-dossier\.php|ardy-grazie-consegna\.php|ardy-social-bozze\.php|ardy-social-foto\.php|ardy-template-scheda-cliente\.html)$">
    AuthType Basic
    AuthName "Area riservata Ardy Lab"
    AuthUserFile /home/micoperibg/public_html/ardyagent.ardy-lab.it/.htpasswd
    Require valid-user
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
